#!/bin/bash
set -e

# ── Helpers ───────────────────────────────────────────────────────
# Resolve the real (non-root) user who invoked the install.

get_real_user() {
    local user="${SUDO_USER:-$(logname 2>/dev/null || whoami)}"
    if [ "$user" = "root" ]; then
        user="$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}')"
    fi
    echo "$user"
}

get_real_home() {
    getent passwd "$1" | cut -d: -f6
}

# ── Main ──────────────────────────────────────────────────────────

case "$1" in
    configure)
        REAL_USER="$(get_real_user)"
        REAL_HOME="$(get_real_home "$REAL_USER")"

        if [ -z "$REAL_USER" ] || [ "$REAL_USER" = "root" ]; then
            echo "WARNING: Could not determine non-root user. Some steps skipped." >&2
        fi

        # Create system config directory
        mkdir -p /etc/uconsole/ssl

        # Copy default config if user config doesn't exist (never overwrite)
        if [ ! -f /etc/uconsole/uconsole.conf ]; then
            cp /opt/uconsole/share/defaults/uconsole.conf.default /etc/uconsole/uconsole.conf
        fi

        # Create user config directory
        if [ -n "$REAL_HOME" ] && [ -d "$REAL_HOME" ]; then
            mkdir -p "${REAL_HOME}/.config/uconsole"
            chown "$REAL_USER":"$(id -gn "$REAL_USER")" "${REAL_HOME}/.config/uconsole"
        fi

        # Set default webdash password if not already configured
        USER_CONF="${REAL_HOME}/.config/uconsole/config.json"
        if [ -f "$USER_CONF" ]; then
            HAS_PW=$(python3 -c "
import json
try:
    with open('$USER_CONF') as f:
        d = json.load(f)
    print('yes' if d.get('webdash_password_hash') else 'no')
except: print('no')
" 2>/dev/null || echo "no")
        else
            HAS_PW="no"
            mkdir -p "$(dirname "$USER_CONF")"
            echo '{}' > "$USER_CONF"
            chown "$REAL_USER":"$(id -gn "$REAL_USER")" "$USER_CONF"
        fi

        if [ "$HAS_PW" = "no" ] && python3 -c "import bcrypt" 2>/dev/null; then
            python3 -c "
import bcrypt, json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    data = {}
h = bcrypt.hashpw(b'clockwork', bcrypt.gensalt()).decode()
data['webdash_password_hash'] = h
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
" "$USER_CONF"
            chown "$REAL_USER":"$(id -gn "$REAL_USER")" "$USER_CONF"
            echo "Default webdash password set (clockwork)"
        fi

        # Generate self-signed SSL cert if not present
        if [ ! -f /etc/uconsole/ssl/uconsole.crt ]; then
            openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
                -keyout /etc/uconsole/ssl/uconsole.key \
                -out /etc/uconsole/ssl/uconsole.crt \
                -subj "/CN=uconsole.local" \
                -addext "subjectAltName=DNS:uconsole.local,DNS:uconsole,IP:127.0.0.1" \
                2>/dev/null
            chgrp www-data /etc/uconsole/ssl/uconsole.key
            chmod 640 /etc/uconsole/ssl/uconsole.key
        fi

        # Make all scripts executable
        find /opt/uconsole/ -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true
        find /opt/uconsole/ -name "*.py" -exec chmod +x {} \; 2>/dev/null || true
        chmod +x /opt/uconsole/bin/* 2>/dev/null || true

        # Inject actual username into all service units
        if [ -n "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
            for unit in /etc/systemd/system/uconsole-*.service; do
                [ -f "$unit" ] && sed -i "s/UCONSOLE_USER/${REAL_USER}/g" "$unit"
            done
        fi

        # Enable nginx site
        if [ -f /etc/nginx/sites-available/uconsole-webdash ]; then
            ln -sf /etc/nginx/sites-available/uconsole-webdash /etc/nginx/sites-enabled/uconsole-webdash
            nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || true
        fi

        # Reload systemd to pick up new unit files (but do NOT enable or start)
        systemctl daemon-reload 2>/dev/null || true

        # ── Security cleanup: remove leaky backup.sh from prior versions ──
        # Versions 0.1.0 through 0.2.1 shipped /opt/uconsole/scripts/system/
        # backup.sh which captures WiFi PSKs, sudoers, gh OAuth token, etc.
        # The script doesn't auto-run (uconsole-backup.timer is not auto-
        # enabled by this postinst), but ships executable. Devices that
        # enabled the timer AND had /opt/uconsole as a git repo could
        # have leaked credentials.
        #
        # On upgrade from any leaky version, remove the file. Operator-
        # installed copies (the maintainer's private backup repo into
        # /opt/uconsole/scripts/system/) would also be cleaned, but those
        # belong in ~/pkg/scripts/system/backup.sh anyway, not /opt/.
        # See device/docs/PUBLISHING.md for the full post-mortem.
        if [ -n "${2:-}" ] && dpkg --compare-versions "$2" le-nl 0.2.1 \
                2>/dev/null; then
            if [ -f /opt/uconsole/scripts/system/backup.sh ]; then
                rm -f /opt/uconsole/scripts/system/backup.sh
                echo "Security: removed leaky backup.sh shipped in $2 (now in" \
                     "the operator-private ~/pkg/ backup repo only)."
                echo "  See https://github.com/mikevitelli/uconsole-cloud" \
                     "release notes for v0.2.2 if you ran it from a git" \
                     "working tree — rotate WiFi PSKs and GitHub PATs."
            fi
        fi

        # ── Retire device-specific battery / VOFF units ───────────────
        # The 18650/CM4-specific PMIC tweaks (battery-safety stack and the
        # Fix Battery Boot service) are no longer shipped — they hardcoded
        # i2c bus 0 and a 2.9V VOFF cutoff tuned for 18650 cells, which is
        # wrong on CM5 and unsafe for other chemistries. On upgrade,
        # disable any that an earlier install enabled and clear stale state.
        RETIRED_UNITS="pmu-voltage-min.service cpu-freq-cap.service \
low-battery-shutdown.service crash-log.service axp-voff-shutdown.service"
        for unit in $RETIRED_UNITS; do
            systemctl disable --now "$unit" 2>/dev/null || true
        done
        systemctl reset-failed $RETIRED_UNITS 2>/dev/null || true

        # Remove the VOFF payload the retired Fix Battery Boot installed
        # at runtime, OUTSIDE dpkg's file list (fix-battery-boot.sh copied
        # these into /etc, and the script itself is gone, so nothing else
        # can clean them). Left in place, the premount hook keeps forcing
        # `i2cset -f -y 0 0x34 0x31 0x03` (bus 0 — wrong on CM5) from the
        # initramfs every boot, and update-initramfs re-bakes it into
        # every new kernel.
        #
        # /etc/udev/rules.d/99-uconsole-battery.rules is deliberately NOT
        # removed: the kept fix-voltage-cutoff.sh installs the identical
        # rule, so an existing rule may be the user's supported opt-in.
        VOFF_HOOK_REMOVED=0
        for f in /etc/initramfs-tools/hooks/axp-voff \
                 /etc/initramfs-tools/scripts/init-premount/axp-voff; do
            if [ -f "$f" ]; then
                rm -f "$f"
                VOFF_HOOK_REMOVED=1
                echo "Retired battery boot fix: removed $f"
            fi
        done
        if [ -f /etc/systemd/system/axp-voff-shutdown.service ]; then
            rm -f /etc/systemd/system/axp-voff-shutdown.service
            systemctl daemon-reload 2>/dev/null || true
            echo "Retired battery boot fix: removed orphaned axp-voff-shutdown.service"
        fi
        if [ "$VOFF_HOOK_REMOVED" = "1" ]; then
            if command -v update-initramfs >/dev/null 2>&1 \
                    && update-initramfs -u >/dev/null 2>&1; then
                echo "Rebuilt initramfs without the retired VOFF hook."
            else
                echo "WARNING: initramfs rebuild failed or unavailable —" \
                     "run 'sudo update-initramfs -u' to purge the retired" \
                     "VOFF hook from the current initrd." >&2
            fi
        fi

        # Clean up orphaned ~/scripts/ compat symlinks from the old manual fix.
        if [ -n "$REAL_HOME" ] && [ -d "${REAL_HOME}/scripts" ]; then
            for name in pmu-voltage-min low-battery-shutdown cpu-freq-cap \
                        crash-log; do
                LINK="${REAL_HOME}/scripts/${name}.sh"
                [ -L "$LINK" ] && rm -f "$LINK"
            done
            rmdir "${REAL_HOME}/scripts" 2>/dev/null || true
        fi

        # ── gpsd config for AIO board GPS ──
        # Only configure if: gpsd is installed, UART exists, config file present
        if command -v gpsd >/dev/null 2>&1 && [ -e /dev/ttyS0 ] && [ -f /etc/default/gpsd ]; then
            if grep -q 'GPSD_OPTIONS=' /etc/default/gpsd 2>/dev/null; then
                if ! grep -q -- '-b' /etc/default/gpsd 2>/dev/null; then
                    sed -i '/^GPSD_OPTIONS=/ s/"$/ -b"/' /etc/default/gpsd
                    systemctl restart gpsd 2>/dev/null || true
                    echo "Added -b flag to gpsd (keeps NMEA mode for satellite data)"
                fi
            fi
        fi

        # Detect and stop old user-level webdash service
        if [ -n "$REAL_HOME" ]; then
            OLD_SVC="${REAL_HOME}/.config/systemd/user/webdash.service"
            if [ -f "$OLD_SVC" ]; then
                echo "Migrating from user-level webdash to system service..."
                su - "$REAL_USER" -c "systemctl --user stop webdash.service 2>/dev/null; systemctl --user disable webdash.service 2>/dev/null" || true
                echo "Old user-level webdash.service stopped and disabled."
            fi

            # Migrate status.env from old location if needed
            OLD_ENV="${REAL_HOME}/.config/uconsole/status.env"
            if [ -f "$OLD_ENV" ] && [ ! -f /etc/uconsole/status.env ]; then
                cp "$OLD_ENV" /etc/uconsole/status.env
                chown "$REAL_USER":"$(id -gn "$REAL_USER")" /etc/uconsole/status.env
                chmod 600 /etc/uconsole/status.env
                echo "Migrated cloud config from ${OLD_ENV} to /etc/uconsole/status.env"
            fi
        fi

        # Add Ctrl+` keybind for console TUI if labwc is installed
        if [ -n "$REAL_HOME" ]; then
            LABWC_RC="${REAL_HOME}/.config/labwc/rc.xml"
            if [ -f "$LABWC_RC" ] && ! grep -q 'C-grave' "$LABWC_RC" 2>/dev/null; then
                SNIPPET="/opt/uconsole/share/defaults/labwc-keybind.xml"
                if [ -f "$SNIPPET" ]; then
                    sed -i '/<keyboard>/r '"$SNIPPET" "$LABWC_RC"
                    echo "Added Ctrl+\` keybind for console TUI"
                fi
            fi
        fi

        echo ""
        echo "========================================"
        echo "  uconsole-cloud installed!"
        echo ""
        echo "  Run 'uconsole setup' to configure"
        echo "  your device."
        echo ""
        echo "  Commands:"
        echo "    uconsole setup    Configure device"
        echo "    uconsole doctor   Check system health"
        echo "    uconsole help     See all commands"
        echo ""
        echo "========================================"
        echo ""
        ;;
esac
